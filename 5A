class DesktopLayout extends StatelessWidget {
  const DesktopLayout({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: const CatalogAppBar(),
      body: Row(
        children: [
          NavigationRail(
            selectedIndex: 0,
            onDestinationSelected: (index) {},
            labelType: NavigationRailLabelType.all,
            destinations: const [
              NavigationRailDestination(
                icon: Icon(Icons.home),
                label: Text('Home'),
              ),
              NavigationRailDestination(
                icon: Icon(Icons.shopping_bag),
                label: Text('Products'),
              ),
              NavigationRailDestination(
                icon: Icon(Icons.settings),
                label: Text('Settings'),
              ),
            ],
          ),
          const VerticalDivider(width: 1),
          Expanded(
            child: Column(
              children: [
                const LayoutInfo(label: 'Desktop Layout - 3 Columns'),

                // Local state exists only in the desktop layout.
                const DesktopCounter(),

                Expanded(
                  child: Consumer<CatalogProvider>(
                    builder: (context, catalog, child) {
                      return GridView.builder(
                        padding: const EdgeInsets.all(16),
                        itemCount: catalog.items.length,
                        gridDelegate:
                            const SliverGridDelegateWithFixedCrossAxisCount(
                          crossAxisCount: 3,
                          crossAxisSpacing: 16,
                          mainAxisSpacing: 16,
                          childAspectRatio: 1.3,
                        ),
                        itemBuilder: (context, index) {
                          return ProductCard(
                            item: catalog.items[index],
                          );
                        },
                      );
                    },
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}

// -------------------- LOCAL STATE: SETSTATE --------------------

class DesktopCounter extends StatefulWidget {
  const DesktopCounter({super.key});

  @override
  State<DesktopCounter> createState() => _DesktopCounterState();
}

class _DesktopCounterState extends State<DesktopCounter> {
  int counter = 0;

  @override
  Widget build(BuildContext context) {
    return Card(
      margin: const EdgeInsets.all(12),
      child: Padding(
        padding: const EdgeInsets.symmetric(
          horizontal: 20,
          vertical: 8,
        ),
        child: Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            const Text(
              'Local Counter: ',
              style: TextStyle(fontWeight: FontWeight.bold),
            ),
            Text(
              '$counter',
              style: const TextStyle(
                fontSize: 20,
                color: Colors.indigo,
              ),
            ),
            const SizedBox(width: 12),
            IconButton(
              tooltip: 'Increment counter',
              onPressed: () {
                setState(() {
                  counter++;
                });
              },
              icon: const Icon(
                Icons.add_circle,
                color: Colors.indigo,
              ),
            ),
          ],
        ),
      ),
    );
  }
}

// -------------------- PRODUCT CARD --------------------

class ProductCard extends StatelessWidget {
  final CatalogItem item;

  const ProductCard({
    super.key,
    required this.item,
  });

  @override
  Widget build(BuildContext context) {
    return Card(
      color: item.color,
      elevation: 3,
      margin: const EdgeInsets.symmetric(vertical: 6),
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(16),
      ),
      child: Padding(
        padding: const EdgeInsets.all(12),
        child: Row(
          children: [
            Icon(
              item.icon,
              size: 42,
              color: Colors.indigo,
            ),
            const SizedBox(width: 12),
            Expanded(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    item.name,
                    style: const TextStyle(
                      fontSize: 17,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  const SizedBox(height: 4),
                  Flexible(
                    child: Text(
                      item.description,
                      style: const TextStyle(fontSize: 12),
                    ),
                  ),
                ],
              ),
            ),
            Consumer<CatalogProvider>(
              builder: (context, catalog, child) {
                final favorite = catalog.isFavorite(item.id);

                return IconButton(
                  tooltip: favorite
                      ? 'Remove from favorites'
                      : 'Add to favorites',
                  onPressed: () {
                    catalog.toggleFavorite(item.id);
                  },
                  icon: Icon(
                    favorite ? Icons.star : Icons.star_border,
                    color: favorite ? Colors.amber.shade800 : Colors.grey,
                    size: 30,
                  ),
                );
              },
            ),
          ],
        ),
      ),
    );
  }
}

