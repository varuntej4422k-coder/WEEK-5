import 'package:flutter/material.dart';
import 'package:provider/provider.dart';

void main() {
  runApp(
    ChangeNotifierProvider(
      create: (_) => CatalogProvider(),
      child: const MyApp(),
    ),
  );
}

// -------------------- MODEL --------------------

class CatalogItem {
  final int id;
  final String name;
  final String description;
  final IconData icon;
  final Color color;

  CatalogItem({
    required this.id,
    required this.name,
    required this.description,
    required this.icon,
    required this.color,
  });
}

// -------------------- SHARED STATE: PROVIDER --------------------

class CatalogProvider extends ChangeNotifier {
  final List<CatalogItem> items = [
    CatalogItem(
      id: 1,
      name: 'Laptop',
      description: 'Powerful computing device',
      icon: Icons.laptop,
      color: Colors.blue.shade100,
    ),
    CatalogItem(
      id: 2,
      name: 'Smartphone',
      description: 'Stay connected everywhere',
      icon: Icons.smartphone,
      color: Colors.green.shade100,
    ),
    CatalogItem(
      id: 3,
      name: 'Headphones',
      description: 'Enjoy your favorite music',
      icon: Icons.headphones,
      color: Colors.orange.shade100,
    ),
    CatalogItem(
      id: 4,
      name: 'Camera',
      description: 'Capture beautiful moments',
      icon: Icons.camera_alt,
      color: Colors.purple.shade100,
    ),
    CatalogItem(
      id: 5,
      name: 'Smartwatch',
      description: 'Track your daily activities',
      icon: Icons.watch,
      color: Colors.pink.shade100,
    ),
    CatalogItem(
      id: 6,
      name: 'Tablet',
      description: 'Portable entertainment',
      icon: Icons.tablet,
      color: Colors.teal.shade100,
    ),
  ];

  final Set<int> _favorites = {};

  bool isFavorite(int id) => _favorites.contains(id);

  int get favoriteCount => _favorites.length;

  void toggleFavorite(int id) {
    if (!_favorites.add(id)) {
      _favorites.remove(id);
    }

    notifyListeners();
  }
}

// -------------------- MAIN APP --------------------

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Responsive Catalog',
      theme: ThemeData(
        colorSchemeSeed: Colors.indigo,
        useMaterial3: true,
      ),
      home: const CatalogScreen(),
    );
  }
}

// -------------------- RESPONSIVE SCREEN --------------------

class CatalogScreen extends StatelessWidget {
  const CatalogScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final width = constraints.maxWidth;

        if (width >= 1024) {
          return const DesktopLayout();
        } else if (width >= 600) {
          return const TabletLayout();
        } else {
          return const MobileLayout();
        }
      },
    );
  }
}

// -------------------- APP BAR --------------------

class CatalogAppBar extends StatelessWidget
    implements PreferredSizeWidget {
  const CatalogAppBar({super.key});

  @override
  Size get preferredSize => const Size.fromHeight(kToolbarHeight);

  @override
  Widget build(BuildContext context) {
    return AppBar(
      title: const Text(
        'Product Catalog',
        style: TextStyle(fontWeight: FontWeight.bold),
      ),
      backgroundColor: Colors.indigo,
      foregroundColor: Colors.white,
      actions: [
        Padding(
          padding: const EdgeInsets.only(right: 16),
          child: Center(
            child: Consumer<CatalogProvider>(
              builder: (context, catalog, child) {
                return Badge(
                  label: Text('${catalog.favoriteCount}'),
                  child: const Icon(
                    Icons.favorite,
                    size: 28,
                  ),
                );
              },
            ),
          ),
        ),
      ],
    );
  }
}

// -------------------- MOBILE LAYOUT --------------------

class MobileLayout extends StatelessWidget {
  const MobileLayout({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: const CatalogAppBar(),
      body: Column(
        children: [
          const LayoutInfo(label: 'Mobile Layout - 1 Column'),
          Expanded(
            child: Consumer<CatalogProvider>(
              builder: (context, catalog, child) {
                return ListView.builder(
                  padding: const EdgeInsets.all(12),
                  itemCount: catalog.items.length,
                  itemBuilder: (context, index) {
                    return ProductCard(
                      item: catalog.items[index],
                    );
                  },
                );
              },
            ),
          ),
        ],
      ),
    );
  }
}

// -------------------- TABLET LAYOUT --------------------

